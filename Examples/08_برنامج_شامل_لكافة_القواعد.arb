برنامج التطبيق_المتكامل_الشامل ؛

/* مثال 8: برنامج متكامل يجمع الثوابت والمتغيرات والشروط والحلقات والعمليات */
ثابت
    الحد_الاقصى = 100 ؛
    قيمة_الخصم = 10 ؛

متغير
    السعر_الاصلي , السعر_النهائي : صحيح ؛
    العدد : صحيح ؛


{
    السعر_الاصلي = 80 ؛
    السعر_النهائي = السعر_الاصلي - قيمة_الخصم ؛  
   اقرا(السعر_الاصلي )؛
    اطبع ( "السعر الاصلي = " , السعر_الاصلي ) ؛
    اطبع ( "السعر النهائي بعد الخصم = " , السعر_النهائي ) ؛

    اذا ( السعر_النهائي < الحد_الاقصى ) فان {
        اطبع ( "السعر ضمن الحد المسموح به" ) ؛
    } والا {
        اطبع ( "السعر تجاوز الحد الاقصى" ) ؛
    } ؛

    اطبع ( "--- استعراض ارقام الفاتورة ---" ) ؛
    كرر ( العدد = 1 الى 3 اضف 1 ) {
        اطبع ( "رقم العنصر = " , العدد ) ؛
    } ؛

    اطبع ( "=== اكتملت عملية الشراء بنجاح ===" ) ؛
} .

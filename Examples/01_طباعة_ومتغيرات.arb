برنامج حساب_المتغيرات_والعمليات ؛

/* مثال 1: تعريف المتغيرات بأنواعها المختلفة والعمليات الحسابية بأسبقية المعاملات */
ثابت
    الحد_الادنى = 10 ؛
    النسبة_المئوية = 0.25 ؛

متغير
    العدد_الاول , العدد_الثاني , الناتج : صحيح ؛
    المعدل : حقيقي ؛

{
    العدد_الاول = 100 ؛
    العدد_الثاني = 20 ؛
    
    /* فحص أسبقية العمليات: الضرب والقسمة قبل الجمع والطرح */
    الناتج = العدد_الاول + العدد_الثاني * 2 - 10 \ 2 ؛
    
    اطبع ( "العدد الاول = " , العدد_الاول ) ؛
    اطبع ( "العدد الثاني = " , العدد_الثاني ) ؛
    اطبع ( "ناتج المعادلة الحسابية = " , الناتج ) ؛
} .
